// Cloudflare Workers static-assets deploy for the POS (used when the project is a Worker, not a Pages project).
// Build first (`pnpm --filter @kiosk/pos build`), then `npx wrangler deploy` uploads apps/pos/dist.
{
  "name": "pos",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./apps/pos/dist",
    "not_found_handling": "single-page-application"
  }
}
