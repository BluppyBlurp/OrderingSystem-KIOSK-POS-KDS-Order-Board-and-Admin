# Development only (not secrets). Production builds get VITE_API_URL from the deploy environment,
# and the device token is entered once on the kiosk's setup screen.
VITE_API_URL=http://localhost:5202
# Matches Dev:KioskToken in backend appsettings.Development.json; the API seeds this device in Development.
VITE_DEV_DEVICE_TOKEN=dev_local-kiosk-token-for-development-only
VITE_TABLE_MIN=1
VITE_TABLE_MAX=60
